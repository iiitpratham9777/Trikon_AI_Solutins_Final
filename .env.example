# Copy to backend/.env (scripts/setup.ps1 does this for you). All values are optional;
# the defaults below target a 4 GB GPU laptop: Whisper + Kokoro on CPU, LLM on the GPU via Ollama.

# --- Speech-to-text (Faster-Whisper) ---
WHISPER_MODEL=small            # tiny | base | small | medium. Hindi needs at least small.
WHISPER_DEVICE=cpu             # cpu | cuda | auto  (cuda needs cuBLAS/cuDNN 12, see README)
WHISPER_COMPUTE_TYPE=int8      # cpu: int8. cuda: int8_float16 or float16
WHISPER_CPU_THREADS=4
WHISPER_BEAM_SIZE=1            # 1 = fastest (greedy). 5 = most accurate.

# --- LLM (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_NUM_CTX=2048               # smaller = less VRAM
LLM_MAX_TOKENS=200             # voice replies are short
LLM_TEMPERATURE=0.6
LLM_KEEP_ALIVE=10m

# --- Text-to-speech ---
TTS_ENGINE=kokoro              # kokoro | piper
TTS_DEVICE=cpu                 # keep on cpu so the LLM keeps the VRAM
KOKORO_VOICE_EN=af_heart
KOKORO_VOICE_HI=hf_alpha
# Piper alternative (only if TTS_ENGINE=piper):
# PIPER_EXECUTABLE=piper
# PIPER_MODEL_EN=C:\voices\en_US-lessac-medium.onnx
# PIPER_MODEL_HI=C:\voices\hi_IN-pratham-medium.onnx

# --- Conversation, limits ---
MAX_HISTORY_TURNS=6            # user+assistant pairs kept per session
MAX_UPLOAD_MB=10
STAGE_CONCURRENCY=1            # simultaneous calls per model stage
WARMUP_ON_START=true           # load models in the background at startup
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
